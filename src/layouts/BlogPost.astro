---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CommentSection from "../components/CommentSection.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { collectionPath, estimateReadingMinutes, tagPath } from "../utils/content";
import { withBase } from "../utils/withBase";
import SiteLayout from "./SiteLayout.astro";

type BlogPostData = CollectionEntry<"blog">["data"];
interface Props extends BlogPostData { body?: string; enableComments?: boolean }
const { title, description, pubDate, updatedDate, heroImage, collection, tags = [], body = "", enableComments = false } = Astro.props;
---
<SiteLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate} updatedTime={updatedDate}>
  <article class="post-article">
    <header class="post-header">
      <nav aria-label="パンくずリスト"><a href={withBase("/blog/")}>記事</a>{collection && <span>/</span>}{collection && <a href={withBase(collectionPath(collection))}>{collection}</a>}</nav>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <div class="meta"><span>公開日 <FormattedDate date={pubDate} /></span>{updatedDate && <span>更新日 <FormattedDate date={updatedDate} /></span>}<span>約 {estimateReadingMinutes(body)} 分</span></div>
      {tags.length > 0 && <div class="tags">{tags.map((tag) => <a href={withBase(tagPath(tag))}>#{tag}</a>)}</div>}
    </header>
    {heroImage && <div class="hero-image"><Image width={840} height={420} src={heroImage} alt={title} /></div>}
    <div class="prose content-prose"><slot />{enableComments && <CommentSection />}</div>
  </article>
</SiteLayout>
<style>
  .post-header,.prose { width:var(--reading-max-width); max-width:100%; margin-right:auto; margin-left:auto; }
  .post-header { margin-bottom:1.4rem; }
  nav { display:flex; margin-bottom:.55rem; gap:.4rem; color:var(--text-muted); font-size:var(--text-xs); } nav a { color:var(--text-muted); text-decoration:none; }
  h1 { min-width:0; margin:0; font-size:var(--text-3xl); line-height:var(--line-height-tight); letter-spacing:0; overflow-wrap:anywhere; }
  .description { margin:.45rem 0 0; color:var(--text-secondary); font-size:var(--text-sm); } .meta,.tags { display:flex; margin-top:.55rem; flex-wrap:wrap; gap:.35rem .8rem; color:var(--text-muted); font-size:var(--text-xs); } .tags { margin-top:.35rem; } .tags a { text-decoration:none; }
  .hero-image { margin-bottom:1.4rem; } .hero-image img { width:100%; }
</style>
<script>
  document.addEventListener("click", (e) => {
    const img = e.target.closest(".content-prose img, .hero-image img");
    const svg = !img ? e.target.closest(".content-prose svg[id^=\"mermaid-\"]") : null;
    const target = img || svg;
    if (!target || target.closest(".lightbox-overlay")) return;

    const isDark = document.documentElement.classList.contains("dark");
    const overlay = document.createElement("div");
    overlay.className = "lightbox-overlay";
    overlay.style.cssText = `position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:${isDark ? "rgba(0,0,0,.85)" : "rgba(0,0,0,.7)"};cursor:zoom-out;opacity:0;transition:opacity .25s ease;`;

    if (img) {
      overlay.innerHTML = `<img src="${img.src}" alt="${img.alt || ""}" style="max-width:90vw;max-height:90vh;object-fit:contain;border-radius:6px;box-shadow:0 8px 40px rgba(0,0,0,.4);cursor:default;">`;
    } else {
      const clone = svg.cloneNode(true);
      clone.removeAttribute("width");
      clone.style.maxWidth = "90vw";
      clone.style.maxHeight = "90vh";
      clone.style.width = "auto";
      clone.style.height = "auto";
      clone.style.borderRadius = "6px";
      clone.style.boxShadow = "0 8px 40px rgba(0,0,0,.4)";
      clone.style.background = isDark ? "#1e1e1e" : "#fff";
      clone.style.cursor = "default";
      overlay.appendChild(clone);
    }

    const close = () => {
      overlay.style.opacity = "0";
      setTimeout(() => { if (overlay.parentNode) overlay.remove(); }, 260);
      document.removeEventListener("keydown", onKey);
    };
    const onKey = (e) => { if (e.key === "Escape") close(); };
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
    const inner = overlay.querySelector("img, svg");
    if (inner) inner.addEventListener("click", (e) => e.stopPropagation());
    document.addEventListener("keydown", onKey);

    document.body.appendChild(overlay);
    overlay.offsetHeight;
    overlay.style.opacity = "1";
  });
</script>
