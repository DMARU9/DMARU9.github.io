---
import Layout from "../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Home">
  <main class="max-w-3xl mx-auto px-6 md:px-8 py-16">
    <section class="mb-12">
      <h1 class="text-4xl font-bold text-zinc-900 mb-4">
        DMARU9's Website
      </h1>
      <p class="text-zinc-700 leading-7">
        Welcome to my site. Check out my content below.
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href={`${baseUrl}/posts`} class="block p-8 bg-white border rounded-2xl shadow-sm hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Posts</h2>
        <p class="text-zinc-600">Browse my posts.</p>
      </a>

      <a href={`${baseUrl}/blogs`} class="block p-8 bg-white border rounded-2xl shadow-sm hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Blogs</h2>
        <p class="text-zinc-600">Browse my blogs.</p>
      </a>
    </section>
  </main>
</Layout>
