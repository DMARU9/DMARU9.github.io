---
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import { SITE_TITLE } from "../../../consts";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getPublishedPosts, taxonomySlug } from "../../../utils/content";
export async function getStaticPaths() { const posts = await getPublishedPosts(); const tags = new Set(posts.flatMap((post) => post.data.tags ?? [])); return Array.from(tags).map((tag) => ({ params: { slug: taxonomySlug(tag) }, props: { tagName: tag } })); }
const { tagName } = Astro.props; const posts = (await getPublishedPosts()).filter((post) => (post.data.tags ?? []).includes(tagName)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const description = `「${tagName}」に関連する記事。`;
---
<SiteLayout title={`${tagName} | タグ | ${SITE_TITLE}`} description={description}><PageHeader title={tagName} description={description} meta={`${posts.length} 件`} /><PostList posts={posts} showDescription={false} /></SiteLayout>
